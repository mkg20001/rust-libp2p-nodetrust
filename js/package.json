  "description": "js-libp2p client for libp2p-nodetrust: DNS names, ACME certificates and WSS discovery",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js"
  },
  "browser": {
    "./src/store.js": "./src/store.browser.js"
  },
  "bin": {
